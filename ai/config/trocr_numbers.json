{
  "base_model": "microsoft/trocr-small-handwritten",
  "initial_model": "ai/runs/trocr_numbers_final/best",
  "output_directory": "ai/runs/trocr_numbers_numeric",
  "target_formats": ["mass", "integer", "length", "temperature", "decimal", "age", "pressure"],
  "target_characters": "0123456789.,/:+-%=",
