  "eval_batch_size": 8,
  "gradient_accumulation_steps": 2,
  "learning_rate": 0.00001,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_target_length": 32,
  "generation_max_length": 32,
  "freeze_encoder": false,
  "seed": 20261114
}
